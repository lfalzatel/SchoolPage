rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users: Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Activities: Public read, Admin write
    // --- ACTIVITIES Collection ---
    match /activities/{activityId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']));
      
      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // --- ACTIVITY LIKES Collection (Helper) ---
    match /activity_likes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // --- VIDEOS Collection ---
    match /videos/{document=**} {
      allow read: if true; // Public videos
      allow create, update, delete: if isAdmin();
    }
  }
}
