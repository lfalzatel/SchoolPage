rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers de rol ─────────────────────────────────────────────────────
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             userRole() == 'admin';
    }
    function isPrivileged() {
      // admin o lider tienen los mismos permisos por ahora
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             userRole() in ['admin', 'lider'];
    }

    // ── Usuarios ────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Cada usuario puede leer y editar su propio documento
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Admin puede leer TODOS los usuarios (para gestión)
      allow read: if isAdmin();
      // Admin puede cambiar el rol de cualquier usuario
      allow write: if isAdmin();
    }

    match /fcm_tokens/{tokenId} {
      // Users can write their own tokens, or if unauthenticated, they can write tokens but not read others.
      allow write: if true;
      allow read: if isAdmin();
    }

    // --- ACTIVITIES (ROOT) ---
    match /activities/{activityId} {
      allow read: if true;
      allow write: if isAdmin();

      // Activities comments
      match /comments/{commentId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      // Per-photo social (photoStats)
      match /photoStats/{photoIndex} {
        allow read: if true;
        allow write: if request.auth != null;

        // Photo likes
        match /likes/{userId} {
          allow read: if true;
          allow write: if request.auth != null;
        }

        // Photo comments
        match /comments/{commentId} {
          allow read: if true;
          allow write: if request.auth != null;
        }
      }
    }

    match /activity_likes/{likeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /videos/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /documents/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /impacto/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- ASISTENCIA DATOS (attendance records) ---
    match /asistencia_datos/{documentId} {
      allow read: if request.auth != null;
      allow write: if isPrivileged();
    }
  }
}