rules_version = '2';

// ══════════════════════════════════════════════════════════════════
//  Green Force PWA — Firestore Security Rules
//  Proyecto : green-force-pwa-2025
//  Colecciones : users | activities | asistencia_datos | impacto | fcm_tokens
//  Roles       : admin | lider | integrante | miembro | usuario
//  Admins fijos: greenforceiebb@gmail.com | lfalzatel@gmail.com
// ══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────
    //  FUNCIONES AUXILIARES REUTILIZABLES
    // ──────────────────────────────────────────────────────────────

    // ¿El usuario inició sesión?
    function isAuthenticated() {
      return request.auth != null;
    }

    // ¿Es uno de los correos admin hardcodeados en la app?
    function isAdminEmail() {
      return request.auth.token.email in [
        'greenforceiebb@gmail.com',
        'lfalzatel@gmail.com'
      ];
    }

    // ¿Tiene rol 'admin' guardado en su documento de Firestore?
    function isAdminRole() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Es admin si cumple cualquiera de las dos condiciones anteriores
    function isAdmin() {
      return isAuthenticated() && (isAdminEmail() || isAdminRole());
    }

    // ¿Tiene rol 'lider' en su documento de Firestore?
    function isLider() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'lider';
    }

    // ¿Es admin o líder? (permiso intermedio)
    function isAdminOrLider() {
      return isAdmin() || isLider();
    }


    // ══════════════════════════════════════════════════════════════
    //  /users/{uid}
    //  Perfiles creados al registrarse con Google OAuth.
    //  Campos esperados: name, email, role, photo, lastLogin
    // ══════════════════════════════════════════════════════════════
    match /users/{uid} {

      // Cualquier usuario autenticado puede leer perfiles
      // (necesario para mostrar nombres y fotos en la app)
      allow read: if isAuthenticated();

      // Cada usuario puede crear su propio documento al registrarse,
      // pero NO puede asignarse el rol 'admin' por sí solo
      allow create: if request.auth.uid == uid &&
        (!('role' in request.resource.data) ||
          request.resource.data.role in ['usuario', 'miembro', 'integrante']);

      // El usuario puede editar sus propios datos básicos (nombre, foto, etc.)
      // pero no puede cambiar su propio rol — eso solo lo hace un admin
      allow update: if
        (request.auth.uid == uid &&
          !('role' in request.resource.data.diff(resource.data).affectedKeys()))
        || isAdmin();

      // Solo admins pueden eliminar usuarios del sistema
      allow delete: if isAdmin();
    }


    // ══════════════════════════════════════════════════════════════
    //  /activities/{activityId}
    //  Galería de actividades y eventos del grupo ambiental.
    //  Campos esperados: title, description, date, images, year, type
    // ══════════════════════════════════════════════════════════════
    match /activities/{activityId} {

      // La galería es pública — cualquier visitante puede verla
      allow read: if true;

      // Solo admins y líderes pueden agregar, editar o eliminar actividades
      allow create, update, delete: if isAdminOrLider();
    }


    // ══════════════════════════════════════════════════════════════
    //  /asistencia_datos/{docId}
    //  Formulario de asistencia a salidas pedagógicas.
    //  Documentos fijos: 'eventos' y 'registros'
    // ══════════════════════════════════════════════════════════════
    match /asistencia_datos/{docId} {

      // Todos pueden ver el registro completo de asistencia
      allow read: if true;

      // Solo admins y líderes pueden guardar o actualizar los registros
      allow write: if isAdminOrLider();
    }

    // ══════════════════════════════════════════════════════════════
    //  /videos/{videoId}
    //  Videos del proyecto Green Force
    // ══════════════════════════════════════════════════════════════
    match /videos/{videoId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrLider();
    }

    // ══════════════════════════════════════════════════════════════
    //  /documents/{docId}
    //  Documentos subidos del proyecto
    // ══════════════════════════════════════════════════════════════
    match /documents/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrLider();
    }


    // ══════════════════════════════════════════════════════════════
    //  /impacto/stats
    //  Contadores de impacto ambiental (árboles sembrados, residuos, etc.)
    //  Documento fijo: 'stats'
    // ══════════════════════════════════════════════════════════════
    match /impacto/{docId} {

      // Todos los usuarios autenticados pueden ver las estadísticas
      allow read: if isAuthenticated();

      // Solo admins pueden actualizar o crear los contadores de impacto
      allow write: if isAdmin();
    }


    // ══════════════════════════════════════════════════════════════
    //  /fcm_tokens/{tokenId}
    //  Tokens de notificaciones push (Firebase Cloud Messaging).
    //  Campos esperados: uid, token, createdAt
    // ══════════════════════════════════════════════════════════════
    match /fcm_tokens/{tokenId} {

      // Cada usuario solo puede leer su propio token;
      // los admins pueden leer todos (para enviar notificaciones masivas)
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );

      // Cualquier usuario autenticado puede registrar o actualizar su token,
      // siempre que el campo 'uid' coincida con su propio uid
      allow create, update: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;

      // El usuario puede eliminar su propio token al cerrar sesión
      allow delete: if isAuthenticated() &&
        resource.data.uid == request.auth.uid;
    }


    // ══════════════════════════════════════════════════════════════
    //  REGLA DE SEGURIDAD FINAL
    //  Cualquier colección no listada explícitamente queda bloqueada
    // ══════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
