rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read access for images (or auth-only as per prompt preferences? 
    // Prompt said: "Solo usuarios logueados pueden ver". Current: allow read: if request.auth != null; is correct.)
    // Public read access for images (essential for the site to work for visitors)
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Granular Write Rules
    // Allow admin to write anywhere? Or just use specific paths.
    // Prompt: "Usuarios pueden subir fotos... admin puede borrar cualquiera."
    
    // Activities images: activities/{activityId}/{userId}/{fileName}
    match /activities/{activityId}/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Fallback for admin
    match /{allPaths=**} {
      allow write: if request.auth != null && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
